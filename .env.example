# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
# Nothing here is a real value, and no real value belongs in this file.

# --- The gate (lib/auth.ts) ---------------------------------------------------
# Both must be set or nothing authenticates: with either missing the gate fails
# closed and locks the owner out rather than letting the world in.
#
# Not read by any route yet — nothing under `app/` imports `lib/auth.ts`.
APP_PASSWORD=
APP_SECRET=

# --- Research collector (scripts/research.js) ---------------------------------
# Local only. The deployed app never reads this: the collector runs on your own
# machine via `pnpm research`.
BRAVE_API_KEY=

# --- Supabase -----------------------------------------------------------------
# Decided in DECISIONS.md #1, not implemented: nothing reads these yet.
#
# These two are the entire set the recommended server-only shape needs, and both
# already exist in Vercel. The secret key is server-side only — never prefix it
# with NEXT_PUBLIC_ and never import it from a client component.
#
# The Vercel integration also creates SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET, ten POSTGRES_* values, and three
# prefixed NEXT_PUBLIC_POSTGRES_DBSUPABASE_* duplicates. None of them are needed
# unless access moves into the browser or an ORM is added.
#
# For local development, copy both values from the Supabase dashboard: they are
# marked Secret in Vercel, so `vercel env pull` cannot retrieve them.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
